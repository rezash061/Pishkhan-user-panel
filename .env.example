# Base URL of the Pishkhan Api host (server side only; the browser never calls it directly).
PISHKHAN_API_URL=http://localhost:5080
# SignalR hub. Leave empty to use the same origin (/hubs/inbox), which next.config rewrites to the Api host.
# In production Nginx routes app.example.ir/hubs/* to the Api host.
NEXT_PUBLIC_HUB_URL=
# true in production: __Host- cookies, Secure flag. Defaults to NODE_ENV === "production".
COOKIE_SECURE=
