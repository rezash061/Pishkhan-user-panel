    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "4.4.0-0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
